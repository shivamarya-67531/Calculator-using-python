import tkinter as tk

class Calculator:
    def __init__(self, root):
        self.root = root
        self.root.title("Calculator")
        self.root.geometry("350x520")
        self.root.resizable(True, True)

        # Colors
        self.WHITE = "#FFFFFF"
        self.BLACK = "#000000"
        self.YELLOW = "#FFD43B"

        self.root.configure(bg=self.WHITE)

        # Store expression
        self.expression = ""

        # DISPLAY
        self.display = tk.Entry(
            root,
            font=("Arial", 20),
            bg=self.WHITE,
            fg=self.BLACK,
            justify="right",
            bd=2,
            relief="solid"
        )

        self.display.pack(
            fill="both",
            padx=15,
            pady=20,
            ipady=20
        )
        self.display.config(state="readonly")

        # BUTTON FRAME
        button_frame = tk.Frame(
            root,
            bg=self.WHITE
        )
        button_frame.pack(
            expand=True,
            fill="both",
            padx=10,
            pady=10
        )

        # BUTTONS
        buttons = [
            ("C", 0, 0),
            ("⌫", 0, 1),
            ("%", 0, 2),
            ("÷", 0, 3),

            ("7", 1, 0),
            ("8", 1, 1),
            ("9", 1, 2),
            ("x", 1, 3),

            ("4", 2, 0),
            ("5", 2, 1),
            ("6", 2, 2),
            ("-", 2, 3),

            ("1", 3, 0),
            ("2", 3, 1),
            ("3", 3, 2),
            ("+", 3, 3),

            ("+/-", 4, 0),
            ("0", 4, 1),
            (".", 4, 2),
            ("=", 4, 3)
        ]

        for text, row, column in buttons:

            # Yellow buttons
            if text in ["÷", "x", "-", "+", "="]:
                bg_color = self.YELLOW
                fg_color = self.BLACK

            # Black button
            elif text == "C":
                bg_color = self.BLACK
                fg_color = self.WHITE

            # White buttons
            else:
                bg_color = self.WHITE
                fg_color = self.BLACK

            button = tk.Button(
                button_frame,
                text=text,
                font=("Arial", 18, "bold"),
                bg=bg_color,
                fg=fg_color,
                activebackground=self.YELLOW,
                activeforeground=self.BLACK,
                bd=2,
                relief="solid",
                command=lambda value=text: self.button_click(value)
            )

            button.grid(
                row=row,
                column=column,
                padx=4,
                pady=4,
                sticky="nsew"
            )

        # Make rows and columns equal size
        for i in range(5):
            button_frame.rowconfigure(i, weight=1)

        for i in range(4):
            button_frame.columnconfigure(i, weight=1)

        # Keyboard support
        self.root.bind("<Key>", self.keyboard_input)

    
    # UPDATE DISPLAY
    def update_display(self, value):
        self.display.config(state="normal")

        self.display.delete(0, tk.END)
        self.display.insert(0, value)

        self.display.config(state="readonly")

    
    # BUTTON CLICK
    def button_click(self, value):

        # Clear
        if value == "C":
            self.expression = ""
            self.update_display("")
            return

        # Backspace
        if value == "⌫":
            self.expression = self.expression[:-1]
            self.update_display(self.expression)
            return

        # Equal
        if value == "=":
            self.calculate()
            return

        # Percentage
        if value == "%":
            self.percentage()
            return

        # Positive / Negative
        if value == "+/-":
            self.toggle_sign()
            return

        # Convert calculator symbols to Python operators
        if value == "÷":
            value = "/"

        elif value == "x":
            value = "*"

        elif value == "-":
            value = "-"

        self.expression += value
        self.update_display(self.expression)


    # CALCULATE
    def calculate(self):

        if not self.expression:
            return

        try:
            result = eval(
                self.expression,
                {"__builtins__": None},
                {}
            )

            if isinstance(result, float) and result.is_integer():
                result = int(result)

            self.expression = str(result)
            self.update_display(self.expression)

        except ZeroDivisionError:
            self.expression = ""
            self.update_display("Cannot divide by 0")

        except Exception:
            self.expression = ""
            self.update_display("Error")

    
    # PERCENTAGE
    def percentage(self):

        if not self.expression:
            return

        try:
            result = eval(
                self.expression,
                {"__builtins__": None},
                {}
            )

            result = result / 100

            if isinstance(result, float) and result.is_integer():
                result = int(result)

            self.expression = str(result)
            self.update_display(self.expression)

        except Exception:
            self.expression = ""
            self.update_display("Error")

    
    # POSITIVE / NEGATIVE
    def toggle_sign(self):

        if not self.expression:
            return

        try:
            result = eval(
                self.expression,
                {"__builtins__": None},
                {}
            )

            result = -result

            if isinstance(result, float) and result.is_integer():
                result = int(result)

            self.expression = str(result)
            self.update_display(self.expression)

        except Exception:
            self.expression = ""
            self.update_display("Error")

    
    # KEYBOARD INPUT
    def keyboard_input(self, event):

        key = event.keysym
        char = event.char

        # Numbers
        if char in "0123456789":
            self.button_click(char)

        # Decimal
        elif char == ".":
            self.button_click(".")

        # Addition
        elif char == "+":
            self.button_click("+")

        # Subtraction
        elif char == "-":
            self.button_click("−")

        # Multiplication
        elif char == "*":
            self.button_click("×")

        # Division
        elif char == "/":
            self.button_click("÷")

        # Enter
        elif key in ["Return", "KP_Enter"]:
            self.button_click("=")

        # Backspace
        elif key == "BackSpace":
            self.button_click("⌫")

        # Escape
        elif key == "Escape":
            self.button_click("C")

        # Percentage
        elif char == "%":
            self.button_click("%")



# MAIN PROGRAM
if __name__ == "__main__":
    root = tk.Tk()

    calculator = Calculator(root)

    root.mainloop()
